# Copy to /etc/avnac/backend.env (root:root, 0600). Replace all REPLACE values.
# Use NAME=value, without export or shell substitutions.
NODE_ENV=production
LISTEN_HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://avnac:REPLACE_DB_PASSWORD@127.0.0.1:5432/avnac
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
# Public HTTPS origin, without /api or a trailing slash.
BETTER_AUTH_URL=https://avnac.example.com
CORS_ORIGIN=https://avnac.example.com
ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
# Clear after the first administrator sign-in.
ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD
# Optional integrations; leave blank to disable.
UNSPLASH_ACCESS_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
